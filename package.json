{
  "name": "dsh-pwsh7",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pins DSH's pwsh tool to PowerShell 7 and never falls back to Windows PowerShell 5.1.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamyiHu/dsh-pwsh7.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "powershell",
    "pwsh"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
